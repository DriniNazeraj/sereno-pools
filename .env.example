# Copy to .env (git-ignored) before dev or build:  cp .env.example .env
# Local overrides go in .env.local (also git-ignored). There is no committed .env.
# VITE_* values are inlined into the public JS bundle: never put secrets here.

# Canonical site URL (no trailing slash). The single source for <link rel="canonical">, og:url / og:image,
# twitter:image, JSON-LD business data, sitemap.xml and the robots.txt Sitemap line (all written at build time).
# https://www.serenopools.com is a PLACEHOLDER domain that we do not own; set the real domain before launch.
VITE_SITE_URL=https://www.serenopools.com

# Contact form endpoint the browser POSTs JSON to. Leave empty for same-origin /api/contact (api/contact.ts on
# Vercel). Request/response contract: docs/api-contract.md.
VITE_CONTACT_ENDPOINT=

# DEMO / QA SWITCH, NOT AN ENDPOINT. Default false. When "true" the form never calls the network: it waits ~1s
# and pretends success; a message containing the word "fail" shows the error banner. A production build with this
# on logs a console warning and shows a visible "Demo form" note. Use only in .env.local for local previews.
VITE_CONTACT_MOCK=false
